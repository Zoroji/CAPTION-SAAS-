__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
ENV/

# Explicitly include vectors directory and database files (Keep)
!vectors/
!vectors/embeddings.npy
!vectors/image_ids.json
!vectors/metadata.json

# Large zip files
*.zip
