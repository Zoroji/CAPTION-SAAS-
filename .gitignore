# Raw downloaded images (Ignore)
RedditImages/
*.jpg
*.jpeg
*.png
*.webp
*.gif

# RedCaps annotation JSON files (Ignore)
annotations/

# Node & Next.js dependencies / build output
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
.vercel/

# macOS / System metadata
__MACOSX/
.DS_Store
